[Unit]
Description=LRAI Agent GitHub task worker
After=network-online.target lrai-agent-webhook.service
Wants=network-online.target

[Service]
Type=simple
User=lrai-agent
Group=lrai-agent
WorkingDirectory=/opt/lrai-agent
EnvironmentFile=/etc/lrai-agent/webhook.env
ExecStart=/opt/lrai-agent/bin/node /opt/lrai-agent/lib/node_modules/@lrai-engineering/lrai-agent/dist/src/index.js worker
Environment=PATH=/opt/lrai-agent/bin:/usr/bin:/bin
Environment=LRAI_WORKER_TOOLCHAIN=/opt/lrai-agent
Environment=HOME=/var/lib/lrai-agent
Environment=XDG_CONFIG_HOME=/var/lib/lrai-agent/.config
Environment=CODEX_HOME=/var/lib/lrai-agent/.codex
Environment='LRAI_PREVIEW_DEPLOY_COMMAND=["/usr/bin/sudo","-n","/usr/local/sbin/lrai-agent-preview-deploy"]'
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/lrai-agent
NoNewPrivileges=false
# PrivateDevices implies NoNewPrivileges on systemd, which would prevent the
# narrow sudo transition to the root-owned preview deployer below.
PrivateDevices=false

[Install]
WantedBy=multi-user.target
